# command のパスはデプロイ形態に合わせる。実機(2026-07-24 時点)は
# /opt へのデプロイではなくリポジトリ作業ツリーを直接参照しており、
# /etc/robot-ui/applications.yaml の実エントリは以下のように
# software/venv の python でリポジトリ内スクリプトを起動している:
#
#   - name: Micromouse
#     command:
#       - /home/k-iida/dev/daylight/software/venv/bin/python3
#       - /home/k-iida/dev/daylight/software/micromouse/micromouse_app.py
#     priority: 20
#
# 以下は /opt へ正式デプロイした場合の理想形の例。
applications:
  - name: Micromouse
    command:
      - python3
      - /opt/robot/apps/micromouse/micromouse_app.py
    priority: 20

  - name: Pattern Test
    command:
      - python3
      - /opt/robot/apps/micromouse/pattern_test.py
    priority: 10

  - name: Camera Test
    command:
      - python3
      - /opt/robot/apps/camera/camera_test.py
    priority: 20

  - name: Maze
    command:
      - python3
      - /opt/robot/apps/maze.py
    priority: 10

  - name: Motor Test
    command:
      - python3
      - /opt/robot/apps/motor_test.py
    priority: 20
