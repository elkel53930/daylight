# マイクロマウス設定の例。
# このファイルを micromouse.yaml にコピーして編集すると既定値を上書きできる。
# 全項目とその既定値は config.py の MicromouseConfig を参照。

# --- 通信 ---
port: /dev/ttyUSB0
baud: 3000000

# --- 迷路(競技規則) ---
maze_size: 16
cell_size_mm: 180.0
# ゴール領域(中央2x2)。単一セルにする場合は min == max にする。
goal_x_min: 7
goal_x_max: 8
goal_y_min: 7
goal_y_max: 8

# --- 走行 ---
explore_speed_mmps: 300.0
explore_accel_mmps2: 1000.0
speed_run_speed_mmps: 400.0
speed_run_accel_mmps2: 1200.0

# --- 壁判定しきい値(hw_test.py walls で実機校正すること) ---
wall_left_threshold: 100
wall_right_threshold: 100
wall_front_threshold: 50

# --- 安全 ---
battery_min_v: 6.5
max_exploration_steps: 1000

# --- カメラによる位置補正(camera_correction.py、実機のみ有効) ---
# 前壁がある判断点で、前回の補正からこのセル数以上移動していたら
# カメラでヨー角・前進距離を補正し、ジャイロも再キャリブレーションする。
camera_correction_enabled: false
camera_correction_interval_cells: 10
